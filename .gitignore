# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.iml

# Go
/server/bin/
/server/data/
*.test
*.out

# Android
/android/.gradle/
/android/.kotlin/
/android/.idea/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties
/android/captures/
*.apk
*.aab

# iOS: Xcode's per-user state (open files, breakpoints), and build output
xcuserdata/
/ios/build/
# Google's ML Kit frameworks, downloaded by `make ios-mlkit`, and SwiftPM's own
# files should the package be opened on its own (the app pins its versions in
# the Xcode project's Package.resolved)
/ios/MLKit/Frameworks/
/ios/MLKit/.build/
/ios/MLKit/.swiftpm/
/ios/MLKit/Package.resolved

# Whisper models are downloaded, never committed
*.bin
*.gguf

# Local environment, and the host's settings (deploy/env.example is the template)
.env
.env.*
!.env.example

# Signing files and API keys (they go in GitHub secrets, ADR 0022)
*.p8
*.p12
*.mobileprovision
