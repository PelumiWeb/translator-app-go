
# The website on its own domain, once there is one: setup.sh adds this block
# when given the domain. Its waitlist form posts here, to the same name, and
# only that path reaches the server (ADR 0030).
{{SITE_HOST}} {
	handle /v1/waitlist {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		root * /opt/shinar/site
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
