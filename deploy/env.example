# The server's settings on the host, kept in /etc/shinar/env (readable by
# root only). Fill in a copy, outside the repository, and never commit it.
# ADMIN and PASSWORD are the database's administrator login and password.
# The password should be letters and digits only: it sits inside a
# URL, where other characters need escaping.

# Only Caddy, on the same machine, talks to the server.
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://ADMIN:PASSWORD@shinar-db.postgres.database.azure.com:5432/shinar?sslmode=require

AUDIO_DIR=/var/lib/shinar/audio
VOICES_DIR=/var/lib/shinar/voices
MESSAGES_DIR=/var/lib/shinar/messages
MODELS_DIR=/var/lib/shinar/models

FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
GOOGLE_CLIENT_ID=
