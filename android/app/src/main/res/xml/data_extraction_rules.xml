<?xml version="1.0" encoding="utf-8"?>
<!--
   What Android 12 and later may copy off this phone: to the user's cloud
   backup, or to a new phone during setup. Everything is allowed except:

   - voice: the recording of the user's voice. The app promises it stays on
     this phone.
   - models: the Whisper model. It can always be downloaded again, and at
     57 MB it would push the app past the 25 MB cloud backup limit, which
     stops everything else from being backed up.
   - device.xml: facts about this phone, such as how fast it runs the model.
     They would be wrong on another phone.

   backup_rules.xml says the same for Android 11 and earlier.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="voice" />
        <exclude domain="file" path="models" />
        <exclude domain="sharedpref" path="device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="voice" />
        <exclude domain="file" path="models" />
        <exclude domain="sharedpref" path="device.xml" />
    </device-transfer>
</data-extraction-rules>
