<?xml version="1.0" encoding="utf-8"?>
<!--
   The backup rules for Android 11 and earlier. The reasons are in
   data_extraction_rules.xml, which Android 12 and later read instead.
-->
<full-backup-content>
    <exclude domain="file" path="voice" />
    <exclude domain="file" path="models" />
    <exclude domain="sharedpref" path="device.xml" />
</full-backup-content>
