<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark, and petrol behind the first frame, so the app opens straight into the
         Pearl design with no white flash. Only dark is designed. -->
    <style name="Theme.Ptranslate" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/petrol</item>
    </style>

    <!-- While the app starts: the mark on petrol. MainActivity switches to the theme
         above before drawing, so the mark is not left behind the screens. -->
    <style name="Theme.Ptranslate.Starting">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>
</resources>
