{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description. As for the microphone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح رمز QR لشخص تريد إضافته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannt den QR-Code einer Person, die du hinzufügen möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR de alguien a quien quieres añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne le code QR d'une personne que vous voulez ajouter."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana duba lambar QR ta wanda kuke son ƙarawa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसे आप जोड़ना चाहते हैं, उसका QR कोड स्कैन करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindai kode QR orang yang ingin kamu tambahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice QR di qualcuno che vuoi aggiungere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加したい人のQRコードを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하려는 사람의 QR 코드를 스캔합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scant de QR-code van iemand die je wilt toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanuje kod QR osoby, którą chcesz dodać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o código QR de alguém que você quer adicionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирует QR-код человека, которого вы хотите добавить."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huchanganua msimbo wa QR wa mtu unayetaka kumwongeza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklemek istediğin kişinin QR kodunu tarar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканує QR-код людини, яку ви хочете додати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã QR của người bạn muốn thêm."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ó ń ka kóòdù QR ẹni tí o fẹ́ fi kún un."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描你想添加的人的二维码。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description. English comes from Info.plist, with the app's name; the translations leave the name out, since the prompt's title already shows it (ADR 0021).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل ما تقوله ليكتبه ويترجمه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt auf, was du sagst, um es aufzuschreiben und zu übersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba lo que dices para escribirlo y traducirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ce que vous dites pour l'écrire et le traduire."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana naɗar abin da kuke faɗa don a rubuta shi kuma a fassara shi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो कहते हैं उसे लिखने और अनुवाद करने के लिए रिकॉर्ड करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merekam ucapanmu agar bisa ditulis dan diterjemahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra ciò che dici per scriverlo e tradurlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容を文字にして翻訳するために録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 내용을 받아 적고 번역하기 위해 녹음합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neemt op wat je zegt om het op te schrijven en te vertalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywa to, co mówisz, aby to zapisać i przetłumaczyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava o que você diz para escrever e traduzir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает то, что вы говорите, чтобы записать это текстом и перевести."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurekodi unachosema ili kiandikwe na kutafsiriwa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söylediklerini yazıya dökmek ve çevirmek için kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записує те, що ви говорите, щоб записати це текстом і перекласти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm lời bạn nói để viết ra và dịch."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ó ń gba ohun tí o sọ sílẹ̀ kí ó lè kọ ọ́ sílẹ̀ kí ó sì túmọ̀ rẹ̀."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录下你说的话，以便写成文字并翻译。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
