    "Keep going. A few more seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واصل. بضع ثوانٍ أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter so. Noch ein paar Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue. Unos segundos más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez. Encore quelques secondes."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku ci gaba. Wasu 'yan daƙiƙoƙi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखें। बस कुछ सेकंड और।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus. Beberapa detik lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua. Ancora qualche secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま続けてください。あと数秒です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하세요. 몇 초만 더요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga door. Nog een paar seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów dalej. Jeszcze kilka sekund."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue. Mais alguns segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте. Ещё несколько секунд."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Endelea. Sekunde chache zaidi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam et. Birkaç saniye daha."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуйте. Ще кілька секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục. Thêm vài giây nữa."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Máa bá a lọ. Ìṣẹ́jú-àáyá díẹ̀ sí i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续。再几秒。"
          }
        }
      }
    },
    "Keep going. Read to the end.": {
      "localizations": {
        "ar": {
