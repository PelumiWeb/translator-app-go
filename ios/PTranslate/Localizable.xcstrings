    "Sign in to keep your conversations.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لتحتفظ بمحادثاتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, damit deine Unterhaltungen erhalten bleiben."
