            "state": "translated",
            "value": "Вход через Apple не завершился. Попробуйте ещё раз."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuingia kwa Apple hakukukamilika. Tafadhali jaribu tena."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ile giriş tamamlanmadı. Lütfen yeniden dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід через Apple не завершився. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng Apple chưa hoàn tất. Vui lòng thử lại."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Wíwọlé pẹ̀lú Apple kò parí. Jọ̀wọ́ gbìyànjú lẹ́ẹ̀kan sí i."
