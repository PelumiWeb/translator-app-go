        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatti sentire con la tua voce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた自身の声で届けよう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 목소리 그대로 전하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Word gehoord met je eigen stem"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niech słyszą cię twoim własnym głosem"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja ouvido com sua própria voz"
          }
        },
        "ru": {
          "stringUnit": {
