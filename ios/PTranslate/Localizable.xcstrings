    "Not now, sign out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس الآن، تسجيل الخروج"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt nicht, abmelden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no, cerrar sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas maintenant, se déconnecter"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba yanzu ba, fita"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
