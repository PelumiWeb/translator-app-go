    "Use the phone's voice instead": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم صوت الهاتف بدلًا منه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattdessen die Stimme des Telefons verwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar la voz del teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser plutôt la voix du téléphone"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da muryar waya a maimakon haka"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बजाय फ़ोन की आवाज़ इस्तेमाल करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai suara ponsel saja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa invece la voce del telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに電話の声を使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 휴대폰 음성 사용"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik toch de stem van de telefoon"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj zamiast tego głosu telefonu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar a voz do telefone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать голос телефона"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia sauti ya simu badala yake"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onun yerine telefonun sesini kullan"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використати голос телефона"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng giọng của điện thoại"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo ohùn fóònù dípò rẹ̀"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改用手机的声音"
          }
        }
      }
    },
    "Used only to speak your own words. Without it, your messages use the phone's voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم فقط لنطق كلماتك أنت. بدونه، تستخدم رسائلك صوت الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur verwendet, um deine eigenen Worte zu sprechen. Ohne sie verwenden deine Nachrichten die Stimme des Telefons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa para decir tus propias palabras. Sin ella, tus mensajes usan la voz del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert uniquement à dire vos propres mots. Sans elle, vos messages utilisent la voix du téléphone."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana amfani da ita ne kawai don faɗar kalmominku. Ba tare da ita ba, saƙonninku suna amfani da muryar waya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ आपके अपने शब्द बोलने के लिए। इसके बिना आपके संदेश फ़ोन की आवाज़ इस्तेमाल करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dipakai untuk mengucapkan kata-katamu sendiri. Tanpanya, pesanmu memakai suara ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve solo a pronunciare le tue parole. Senza, i tuoi messaggi usano la voce del telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた自身の言葉を話すためだけに使います。声がない場合、メッセージは電話の声で読み上げられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 말을 들려주기 위해서만 쓰여요. 없으면 메시지는 휴대폰 음성을 사용해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen gebruikt om je eigen woorden uit te spreken. Zonder je stem gebruiken je berichten de stem van de telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Służy tylko do wypowiadania twoich własnych słów. Bez niego twoje wiadomości używają głosu telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada só para dizer suas próprias palavras. Sem ela, suas mensagens usam a voz do telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется только чтобы произносить ваши собственные слова. Без него ваши сообщения звучат голосом телефона."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hutumika tu kutamka maneno yako mwenyewe. Bila hiyo, ujumbe wako hutumia sauti ya simu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kendi sözlerini söylemek için kullanılır. O olmadan mesajların telefonun sesini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується лише щоб вимовляти ваші власні слова. Без нього ваші повідомлення звучать голосом телефона."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng để nói lời của chính bạn. Nếu không có, tin nhắn của bạn dùng giọng của điện thoại."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A ń lò ó láti sọ ọ̀rọ̀ tìrẹ nìkan. Láìsí i, àwọn ìfiranṣẹ́ rẹ ń lo ohùn fóònù."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于说出你自己的话。没有它，你的消息将使用手机的声音。"
          }
        }
      }
    },
