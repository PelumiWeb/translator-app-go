    "No words came through. Try again, a little closer to the phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تصل أي كلمات. حاول مرة أخرى وأنت أقرب قليلًا إلى الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kamen keine Worte an. Versuch es noch einmal, etwas näher am Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se oyeron palabras. Inténtalo de nuevo, un poco más cerca del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mot n'est passé. Réessayez, un peu plus près du téléphone."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu kalmomin da suka zo. Ku sake gwadawa, kusa da waya kaɗan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई शब्द नहीं आए। फ़ोन के थोड़ा पास आकर फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada kata yang tertangkap. Coba lagi, sedikit lebih dekat ke ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è arrivata nessuna parola. Riprova, un po' più vicino al telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言葉が届きませんでした。電話に少し近づいて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 말도 들리지 않았어요. 휴대폰에 조금 더 가까이 대고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kwamen geen woorden door. Probeer het opnieuw, iets dichter bij de telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dotarły żadne słowa. Spróbuj ponownie, trochę bliżej telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma palavra foi captada. Tente de novo, um pouco mais perto do telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова не дошли. Попробуйте ещё раз, чуть ближе к телефону."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna maneno yaliyopita. Jaribu tena, karibu kidogo na simu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiç söz gelmedi. Telefona biraz daha yakın, yeniden dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова не дійшли. Спробуйте ще раз, трохи ближче до телефона."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có từ nào lọt qua. Hãy thử lại, gần điện thoại hơn một chút."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ọ̀rọ̀ kankan kò dé. Gbìyànjú lẹ́ẹ̀kan sí i, kí o súnmọ́ fóònù díẹ̀."
