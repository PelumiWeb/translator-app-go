    "That's your voice. Keep it?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا صوتك. هل نحتفظ به؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist deine Stimme. Behalten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa es tu voz. ¿La guardamos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est votre voix. On la garde ?"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan ita ce muryarku. Mu adana ta?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी आवाज़ है। इसे रखें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu suaramu. Simpan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è la tua voce. La teniamo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがあなたの声です。保管しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이게 당신의 목소리예요. 보관할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is je stem. Bewaren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To twój głos. Zachować go?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa é a sua voz. Vamos guardá-la?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ваш голос. Сохранить?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiyo ndiyo sauti yako. Tuihifadhi?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu senin sesin. Saklayalım mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це ваш голос. Зберегти?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là giọng của bạn. Giữ lại nhé?"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohùn rẹ nìyẹn. Ṣé kí a pa á mọ́?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这就是你的声音。要保留吗？"
          }
        }
      }
    },
    "The camera can't scan here. Allow camera access in Settings, or add them by ID.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستطيع الكاميرا المسح هنا. اسمح بالوصول إلى الكاميرا من الإعدادات، أو أضفه بالمعرّف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera kann hier nicht scannen. Erlaube den Kamerazugriff in den Einstellungen oder füge die Person per ID hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no puede escanear aquí. Permite el acceso a la cámara en Ajustes o añádelo por ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil photo ne peut pas scanner ici. Autorisez l'accès à l'appareil photo dans Réglages, ou ajoutez la personne par son ID."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyamarar ba za ta iya dubawa a nan ba. Ku ba da izinin kyamara a Saituna, ko ku ƙara su ta ID."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा यहाँ स्कैन नहीं कर सकता। सेटिंग में कैमरे की अनुमति दें, या उन्हें ID से जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak bisa memindai di sini. Izinkan akses kamera di Pengaturan, atau tambahkan lewat ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non può scansionare qui. Consenti l'accesso alla fotocamera in Impostazioni, o aggiungilo con l'ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではカメラで読み取れません。設定でカメラへのアクセスを許可するか、IDで追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 카메라로 스캔할 수 없어요. 설정에서 카메라 접근을 허용하거나 ID로 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera kan hier niet scannen. Geef toegang tot de camera in Instellingen, of voeg ze toe via ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat nie może tu skanować. Zezwól na dostęp do aparatu w Ustawieniach albo dodaj tę osobę przez ID."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não consegue escanear aqui. Permita o acesso à câmera nos Ajustes ou adicione a pessoa pelo ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера не может сканировать здесь. Разрешите доступ к камере в Настройках или добавьте собеседника по ID."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera haiwezi kuchanganua hapa. Ruhusu kamera kwenye Mipangilio, au mwongeze kwa kitambulisho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera burada tarama yapamıyor. Ayarlar'dan kamera erişimine izin ver ya da onu kimliğiyle ekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера не може сканувати тут. Дозвольте доступ до камери в Параметрах або додайте співрозмовника за ID."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera không quét được ở đây. Cho phép truy cập camera trong Cài đặt, hoặc thêm họ bằng ID."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kámẹ́rà kò lè ka kóòdù níbí. Gba kámẹ́rà láàyè nínú Ètò, tàbí fi wọ́n kún un pẹ̀lú ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机无法在这里扫描。请在设置中允许访问相机，或通过 ID 添加对方。"
          }
        }
      }
    },
