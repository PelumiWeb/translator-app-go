    "This iPhone's processor cannot run the speech model": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معالج هذا الـiPhone لا يستطيع تشغيل نموذج الكلام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozessor dieses iPhone kann das Sprachmodell nicht ausführen"
