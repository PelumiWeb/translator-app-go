          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Endelea. Soma hadi mwisho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam et. Sonuna kadar oku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
