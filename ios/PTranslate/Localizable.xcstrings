    "The recording was silent (%lld dB). Check the microphone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان التسجيل صامتًا (%lld ديسيبل). تحقّق من الميكروفون"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme war stumm (%lld dB). Prüfe das Mikrofon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación estaba en silencio (%lld dB). Revisa el micrófono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement était silencieux (%lld dB). Vérifiez le micro"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Naɗin ya yi shiru (%lld dB). Ku duba makirufo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग में आवाज़ नहीं थी (%lld dB)। माइक्रोफ़ोन जाँचें"
