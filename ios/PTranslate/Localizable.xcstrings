        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하세요. 끝까지 읽어 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga door. Lees tot het einde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów dalej. Przeczytaj do końca."
          }
        },
        "pt": {
          "stringUnit": {
