    "Not now, use the phone's voice": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس الآن، استخدم صوت الهاتف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt nicht, Stimme des Telefons verwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no, usar la voz del teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas maintenant, utiliser la voix du téléphone"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba yanzu ba, yi amfani da muryar waya"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी नहीं, फ़ोन की आवाज़ इस्तेमाल करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nanti saja, pakai suara ponsel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ora, usa la voce del telefono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はしない、電話の声を使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에, 휴대폰 음성 사용"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu niet, gebruik de stem van de telefoon"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie teraz, użyj głosu telefonu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora não, usar a voz do telefone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас, использовать голос телефона"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sasa, tumia sauti ya simu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi değil, telefonun sesini kullan"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зараз, використати голос телефона"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sau, dùng giọng của điện thoại"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kì í ṣe báyìí, lo ohùn fóònù"
          }
        },
