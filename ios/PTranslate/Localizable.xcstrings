          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш тариф"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mpango wako"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш тариф"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói của bạn"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ètò rẹ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的方案"
          }
        }
      }
    },
    "Your purchase couldn't be checked with Apple just now. It will be tried again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من عملية الشراء مع Apple الآن. ستُعاد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf konnte gerade nicht bei Apple geprüft werden. Es wird erneut versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar tu compra con Apple ahora mismo. Se volverá a intentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat n'a pas pu être vérifié auprès d'Apple pour le moment. Nouvel essai plus tard."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya duba sayanku da Apple yanzu ba. Za a sake gwadawa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खरीद अभी Apple से जाँची नहीं जा सकी। फिर से कोशिश की जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelianmu tidak bisa diperiksa dengan Apple sekarang. Akan dicoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare il tuo acquisto con Apple ora. Verrà riprovato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はAppleで購入を確認できませんでした。あとでもう一度試します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 Apple에서 구매를 확인할 수 없었어요. 다시 시도할게요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop kon nu niet bij Apple worden gecontroleerd. Het wordt opnieuw geprobeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz sprawdzić zakupu w Apple. Spróbujemy ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar sua compra com a Apple agora. Vamos tentar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось проверить покупку в Apple. Попробуем ещё раз."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ununuzi wako haukuweza kuthibitishwa na Apple sasa hivi. Utajaribiwa tena."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alman şu anda Apple ile kontrol edilemedi. Yeniden denenecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдалося перевірити покупку в Apple. Спробуємо ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể kiểm tra giao dịch của bạn với Apple lúc này. Sẽ thử lại sau."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A kò lè ṣàyẹ̀wò ìrajà rẹ lọ́dọ̀ Apple báyìí. A ó tún gbìyànjú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法向 Apple 核实你的购买。稍后会再试。"
          }
        }
      }
    },
    "Your purchase is waiting for someone to approve it. It starts as soon as they do.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية الشراء في انتظار موافقة شخص ما. تبدأ بمجرد أن يوافق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet darauf, dass jemand zustimmt. Er beginnt, sobald das geschieht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está esperando a que alguien la apruebe. Empieza en cuanto lo haga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat attend l'approbation de quelqu'un. Il commence dès qu'elle est donnée."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayanku yana jiran wani ya amince. Zai fara da zarar sun amince."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खरीद किसी की मंज़ूरी का इंतज़ार कर रही है। मंज़ूरी मिलते ही शुरू हो जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelianmu menunggu persetujuan seseorang. Langsung dimulai begitu disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto aspetta l'approvazione di qualcuno. Inizia appena arriva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認されるとすぐに始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 누군가의 승인을 기다리고 있어요. 승인되는 즉시 시작돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop wacht op goedkeuring van iemand. Hij begint zodra die er is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zakup czeka na czyjeś zatwierdzenie. Zacznie się, gdy tylko to nastąpi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando a aprovação de alguém. Começa assim que for aprovada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша покупка ждёт одобрения. Она начнётся, как только её одобрят."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ununuzi wako unasubiri mtu auidhinishe. Unaanza mara tu atakapoidhinisha."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alman birinin onayını bekliyor. Onaylanır onaylanmaz başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша покупка чекає на схвалення. Вона почнеться, щойно її схвалять."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch của bạn đang chờ người khác phê duyệt. Nó bắt đầu ngay khi được duyệt."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ìrajà rẹ ń dúró de ìfọwọ́sí ẹnìkan. Yóò bẹ̀rẹ̀ ní kété tí wọ́n bá fọwọ́ sí i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在等待他人批准。批准后立即开始。"
          }
        }
      }
    },
    "Your recording is deleted from our server and this phone. The people you talk to will hear your messages in the phone's voice. You can record again at any time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحذف تسجيلك من خادمنا ومن هذا الهاتف. سيسمع من تتحدث معهم رسائلك بصوت الهاتف. يمكنك التسجيل مرة أخرى في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahme wird von unserem Server und diesem Telefon gelöscht. Die Menschen, mit denen du sprichst, hören deine Nachrichten mit der Stimme des Telefons. Du kannst jederzeit neu aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu grabación se borra de nuestro servidor y de este teléfono. Las personas con quienes hablas oirán tus mensajes con la voz del teléfono. Puedes volver a grabar cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre enregistrement est supprimé de notre serveur et de ce téléphone. Les personnes à qui vous parlez entendront vos messages avec la voix du téléphone. Vous pouvez en enregistrer un autre à tout moment."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Za a goge naɗinku daga sabar mu da kuma wannan wayar. Mutanen da kuke magana da su za su ji saƙonninku da muryar waya. Kuna iya sake naɗa a kowane lokaci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रिकॉर्डिंग हमारे सर्वर और इस फ़ोन से हटा दी जाती है। जिनसे आप बात करते हैं, वे आपके संदेश फ़ोन की आवाज़ में सुनेंगे। आप कभी भी फिर से रिकॉर्ड कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekamanmu dihapus dari server kami dan dari ponsel ini. Orang yang kamu ajak bicara akan mendengar pesanmu dengan suara ponsel. Kamu bisa merekam lagi kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua registrazione viene eliminata dal nostro server e da questo telefono. Le persone con cui parli sentiranno i tuoi messaggi con la voce del telefono. Puoi registrare di nuovo quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は私たちのサーバーとこの電話から削除されます。話す相手には、メッセージが電話の声で聞こえます。いつでも録音し直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 저희 서버와 이 휴대폰에서 삭제돼요. 대화하는 사람들은 내 메시지를 휴대폰 음성으로 듣게 돼요. 언제든 다시 녹음할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opname wordt van onze server en van deze telefoon verwijderd. De mensen met wie je praat, horen je berichten met de stem van de telefoon. Je kunt altijd opnieuw opnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje nagranie zostanie usunięte z naszego serwera i z tego telefonu. Osoby, z którymi rozmawiasz, usłyszą twoje wiadomości głosem telefonu. W każdej chwili możesz nagrać ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua gravação é apagada do nosso servidor e deste telefone. As pessoas com quem você fala vão ouvir suas mensagens com a voz do telefone. Você pode gravar de novo quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша запись удаляется с нашего сервера и с этого телефона. Собеседники будут слышать ваши сообщения голосом телефона. Вы можете записать голос снова в любой момент."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi yako inafutwa kwenye seva yetu na kwenye simu hii. Watu unaozungumza nao watasikia ujumbe wako kwa sauti ya simu. Unaweza kurekodi tena wakati wowote."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydın sunucumuzdan ve bu telefondan silinir. Konuştuğun kişiler mesajlarını telefonun sesiyle duyar. İstediğin zaman yeniden kaydedebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш запис видаляється з нашого сервера й із цього телефона. Співрозмовники чутимуть ваші повідомлення голосом телефона. Ви можете записати голос знову будь-коли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm của bạn bị xóa khỏi máy chủ và điện thoại này. Những người bạn trò chuyện sẽ nghe tin nhắn của bạn bằng giọng điện thoại. Bạn có thể ghi âm lại bất cứ lúc nào."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A ó pa ohùn tí o gbà sílẹ̀ rẹ́ lórí sáfà wa àti lórí fóònù yìí. Àwọn tí o ń bá sọ̀rọ̀ yóò gbọ́ àwọn ìfiranṣẹ́ rẹ ní ohùn fóònù. O lè tún gbà sílẹ̀ nígbàkigbà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的录音会从我们的服务器和这部手机上删除。和你交谈的人将用手机的声音听到你的消息。你可以随时重新录制。"
          }
        }
      }
    },
    "Your rooms couldn't be loaded just now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل غرفك الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Räume konnten gerade nicht geladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar tus salas ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos salons n'ont pas pu être chargés pour le moment."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya loda ɗakunanku yanzu ba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके रूम अभी लोड नहीं हो सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruangmu tidak bisa dimuat sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile caricare le tue stanze ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はルームを読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 대화방을 불러올 수 없었어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ruimtes konden nu niet worden geladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz wczytać twoich pokojów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar suas salas agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось загрузить ваши комнаты."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyumba vyako havikuweza kupakiwa sasa hivi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaların şu anda yüklenemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдалося завантажити ваші кімнати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể tải các phòng của bạn lúc này."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A kò lè ṣí àwọn yàrá rẹ báyìí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法加载你的房间。"
          }
        }
      }
    },
