    "What should people call you?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بماذا يناديك الناس؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sollen dich andere nennen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo quieres que te llamen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment doit-on vous appeler ?"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaya mutane za su kira ku?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोग आपको किस नाम से बुलाएँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang-orang harus memanggilmu apa?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come vuoi che ti chiamino?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何と呼ばれたいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람들이 어떻게 불러야 할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe moeten mensen je noemen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak mają się do ciebie zwracać?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como as pessoas devem chamar você?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как вас называть?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Watu wakuite nani?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlar sana nasıl hitap etsin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як вас називати?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người nên gọi bạn là gì?"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kí ni kí àwọn ènìyàn máa pè ọ́?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大家该怎么称呼你？"
          }
        }
      }
    },
    "What we keep": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما نحتفظ به"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was wir aufbewahren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué guardamos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que nous gardons"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Abin da muke adanawa"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम क्या रखते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang kami simpan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa conserviamo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管するもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관하는 것"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat we bewaren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co przechowujemy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que guardamos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что мы храним"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunachohifadhi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyi saklıyoruz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що ми зберігаємо"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi giữ gì"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohun tí a ń pa mọ́"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们保留什么"
          }
        }
      }
    },
    "What we keep, and why": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما نحتفظ به ولماذا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was wir aufbewahren und warum"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué guardamos y por qué"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que nous gardons, et pourquoi"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Abin da muke adanawa, da dalili"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम क्या रखते हैं और क्यों"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang kami simpan, dan alasannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
