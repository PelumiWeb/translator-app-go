            "value": "Nu niet, uitloggen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie teraz, wyloguj"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora não, sair"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас, выйти"
