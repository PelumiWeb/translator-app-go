        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは%@で話します。相手は%@で聞きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 %@로 말해요. 상대는 %@로 들어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij spreekt %@. Zij horen %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mówisz: %@. Słyszą: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fala %@. Ouvem você em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы говорите: %@. Вас слышат: %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unazungumza %@. Wanasikia %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen %@ konuşursun. Onlar %@ duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви говорите: %@. Вас чують: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn nói %@. Họ nghe %@."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ìwọ ń sọ %@. Wọ́n ń gbọ́ %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说%@。对方听到%@。"
          }
        }
