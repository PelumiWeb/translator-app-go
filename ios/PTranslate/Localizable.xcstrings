    "Nothing was heard. Check the microphone and try again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسمع شيء. تحقّق من الميكروفون وحاول مرة أخرى"
          }
        },
        "de": {
          "stringUnit": {
