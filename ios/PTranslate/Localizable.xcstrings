    "This %lld-second recording, on our server.": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هذا التسجيل ومدته %lld ثوانٍ، على خادمنا."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هذا التسجيل ومدته %lld ثانية، على خادمنا."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هذا التسجيل ومدته %lld ثانية، على خادمنا."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هذا التسجيل ومدته %lld ثانية، على خادمنا."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هذا التسجيل ومدته %lld ثانية، على خادمنا."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هذا التسجيل ومدته %lld ثانية، على خادمنا."
                }
              }
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme von %lld Sekunden, auf unserem Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación de %lld segundos, en nuestro servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement de %lld secondes, sur notre serveur."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan naɗin na daƙiƙa %lld, a sabar mu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह %lld सेकंड की रिकॉर्डिंग, हमारे सर्वर पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman %lld detik ini, di server kami."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione di %lld secondi, sul nostro server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%lld秒の録音を、私たちのサーバーに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %lld초 분량의 녹음을 저희 서버에 보관합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze opname van %lld seconden, op onze server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To %lld-sekundowe nagranie, na naszym serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação de %lld segundos, no nosso servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта %lld-секундная запись — на нашем сервере."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi hii ya sekunde %lld, kwenye seva yetu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %lld saniyelik kayıt, sunucumuzda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей %lld-секундний запис — на нашому сервері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm %lld giây này, trên máy chủ của chúng tôi."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohùn ìṣẹ́jú-àáyá %lld yìí, lórí sáfà wa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段 %lld 秒的录音，保存在我们的服务器上。"
          }
        }
      }
    },
    "This Apple account's subscription belongs to another %@ account. Sign in to that one, or use another Apple account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراك حساب Apple هذا يخص حسابًا آخر على %@. سجّل الدخول إليه، أو استخدم حساب Apple آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo dieses Apple-Accounts gehört zu einem anderen %@-Konto. Melde dich dort an oder verwende einen anderen Apple-Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción de esta cuenta de Apple pertenece a otra cuenta de %@. Inicia sesión en esa o usa otra cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement de ce compte Apple appartient à un autre compte %@. Connectez-vous à celui-ci, ou utilisez un autre compte Apple."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajistar wannan asusun Apple ta wani asusun %@ dabam ce. Ku shiga wancan, ko ku yi amfani da wani asusun Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple अकाउंट की सदस्यता किसी दूसरे %@ अकाउंट की है। उसमें साइन इन करें, या कोई दूसरा Apple अकाउंट इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan akun Apple ini milik akun %@ lain. Masuk ke akun itu, atau pakai akun Apple lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento di questo account Apple appartiene a un altro account %@. Accedi a quello, o usa un altro account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppleアカウントのサブスクリプションは、別の %@ アカウントのものです。そちらにサインインするか、別のAppleアカウントを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정의 구독은 다른 %@ 계정에 속해 있어요. 그 계정으로 로그인하거나 다른 Apple 계정을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het abonnement van dit Apple-account hoort bij een ander %@-account. Log daarop in, of gebruik een ander Apple-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja tego konta Apple należy do innego konta %@. Zaloguj się na tamto konto albo użyj innego konta Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura desta conta Apple pertence a outra conta do %@. Entre nessa conta ou use outra conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка этого Apple ID принадлежит другому аккаунту %@. Войдите в тот аккаунт или используйте другой Apple ID."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usajili wa akaunti hii ya Apple ni wa akaunti nyingine ya %@. Ingia kwenye hiyo, au tumia akaunti nyingine ya Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple hesabının aboneliği başka bir %@ hesabına ait. O hesaba giriş yap ya da başka bir Apple hesabı kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписка цього Apple ID належить іншому акаунту %@. Увійдіть у той акаунт або скористайтеся іншим Apple ID."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký của tài khoản Apple này thuộc về một tài khoản %@ khác. Hãy đăng nhập vào tài khoản đó, hoặc dùng tài khoản Apple khác."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ìforúkọsílẹ̀ àkọọ́lẹ̀ Apple yìí jẹ́ ti àkọọ́lẹ̀ %@ míì. Wọlé sí ìyẹn, tàbí lo àkọọ́lẹ̀ Apple míì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple 账户的订阅属于另一个 %@ 账户。请登录那个账户，或使用另一个 Apple 账户。"
          }
        }
      }
    },
    "This ID could not be checked just now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من هذا المعرّف الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ID konnte gerade nicht geprüft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar este ID ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ID n'a pas pu être vérifié pour le moment."
