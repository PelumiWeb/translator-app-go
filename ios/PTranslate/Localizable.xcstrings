    "Be heard in your own voice": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليسمعك الناس بصوتك أنت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werde mit deiner eigenen Stimme gehört"
          }
        },
        "es": {
          "stringUnit": {
