          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesini kaydetmek için mikrofon izni gerekiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб записати голос, потрібен доступ до мікрофона"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền dùng micrô để ghi âm giọng của bạn"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A nílò àṣẹ máikirofóònù láti gba ohùn rẹ sílẹ̀"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风权限才能录下你的声音"
