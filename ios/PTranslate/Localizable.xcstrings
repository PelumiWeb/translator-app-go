    "Thank you. Send voice notes and messages in your voice, to anyone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لك. أرسل رسائل صوتية ونصية بصوتك، إلى أي شخص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Sende Sprach- und Textnachrichten mit deiner Stimme, an alle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Envía notas de voz y mensajes con tu voz, a quien quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. Envoyez des notes vocales et des messages avec votre voix, à qui vous voulez."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na gode. Aika saƙonnin murya da saƙonni da muryarku, ga kowa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद। अपनी आवाज़ में, किसी को भी वॉइस नोट और संदेश भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih. Kirim pesan suara dan pesan dengan suaramu, kepada siapa saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. Invia note vocali e messaggi con la tua voce, a chiunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。あなたの声で、誰にでもボイスメッセージとメッセージを送れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사합니다. 내 목소리로 누구에게나 음성 메시지와 메시지를 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt. Verstuur spraak- en tekstberichten met je stem, naar iedereen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy. Wysyłaj wiadomości głosowe i tekstowe swoim głosem, do każdego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado. Envie notas de voz e mensagens com a sua voz, para qualquer pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо. Отправляйте голосовые и текстовые сообщения своим голосом, кому угодно."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Asante. Tuma ujumbe wa sauti na ujumbe kwa sauti yako, kwa mtu yeyote."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teşekkürler. Kendi sesinle, herkese sesli mesajlar ve mesajlar gönder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо. Надсилайте голосові та текстові повідомлення своїм голосом, будь-кому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn. Hãy gửi tin nhắn thoại và tin nhắn bằng giọng của bạn, cho bất kỳ ai."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A dúpẹ́. Fi àwọn ìfiranṣẹ́ ohùn àti ìfiranṣẹ́ ránṣẹ́ ní ohùn rẹ, sí ẹnikẹ́ni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢。用你的声音给任何人发送语音消息和文字消息。"
          }
        }
      }
    },
