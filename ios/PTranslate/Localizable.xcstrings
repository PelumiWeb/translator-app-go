    "You'll hear %@ in %@, in their own voice. They'll hear you in %@, in yours.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستسمع %@ بـ%@، بصوته هو. وسيسمعك بـ%@، بصوتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hörst %@ auf %@, mit der eigenen Stimme. Die Person hört dich auf %@, mit deiner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You'll hear %1$@ in %2$@, in their own voice. They'll hear you in %3$@, in yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oirás a %@ en %@, con su propia voz. Te oirá en %@, con la tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous entendrez %@ en %@, avec sa propre voix. On vous entendra en %@, avec la vôtre."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ku ji %@ da %@, da muryarsa ta kansa. Shi zai ji ku da %@, da muryarku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %@ को %@ में, उनकी अपनी आवाज़ में सुनेंगे। वे आपको %@ में, आपकी आवाज़ में सुनेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu akan mendengar %@ dalam bahasa %@, dengan suaranya sendiri. Dia akan mendengarmu dalam bahasa %@, dengan suaramu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentirai %@ in %@, con la sua voce. Ti sentirà in %@, con la tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の言葉は%2$@で、本人の声で聞こえます。相手にはあなたの言葉が%3$@で、あなたの声で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 님의 말을 %2$@로, 본인 목소리로 듣게 돼요. 상대는 내 말을 %3$@로, 내 목소리로 들어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hoort %@ in het %@, met de eigen stem. Zij horen jou in het %@, met de jouwe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usłyszysz osobę %@ w języku: %@, jej własnym głosem. Ona usłyszy ciebie w języku: %@, twoim głosem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai ouvir %@ em %@, com a própria voz. A pessoa vai ouvir você em %@, com a sua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы будете слышать собеседника (%@) на языке «%@» его собственным голосом. Он будет слышать вас на языке «%@» вашим голосом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Utamsikia %@ kwa %@, kwa sauti yake mwenyewe. Atakusikia kwa %@, kwa sauti yako."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisini %@ olarak, kendi sesiyle duyacaksın. O seni %@ olarak, senin sesinle duyacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви чутимете співрозмовника (%@) мовою «%@» його власним голосом. Він чутиме вас мовою «%@» вашим голосом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ nghe %@ bằng %@, với chính giọng của họ. Họ sẽ nghe bạn bằng %@, với giọng của bạn."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ìwọ yóò gbọ́ %@ ní %@, ní ohùn ara rẹ̀. Òun yóò gbọ́ ọ ní %@, ní ohùn rẹ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会用%2$@听到 %1$@，而且是对方自己的声音。对方会用%3$@听到你，而且是你的声音。"
          }
        }
      }
    },
    "You're subscribed": {
