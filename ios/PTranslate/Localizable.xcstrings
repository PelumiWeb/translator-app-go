          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tym razem nie udało się stworzyć twojego głosu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar sua voz desta vez"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот раз не удалось создать ваш голос"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauti yako haikuweza kutengenezwa wakati huu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesin bu sefer oluşturulamadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього разу не вдалося створити ваш голос"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần này chưa tạo được giọng của bạn"
          }
        },
        "yo": {
          "stringUnit": {
