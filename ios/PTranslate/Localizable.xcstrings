            "value": "वह संदेश अभी बोला नहीं जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan itu tidak bisa diucapkan sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile pronunciare quel messaggio ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はそのメッセージを読み上げられませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
