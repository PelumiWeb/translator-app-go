    "Couldn't send this. Your words are kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الإرسال. كلماتك محفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht gesendet werden. Deine Worte bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido enviar. Tus palabras se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoi impossible. Vos mots sont conservés."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya aikawa ba. Kalmominku suna nan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजा नहीं जा सका। आपके शब्द सुरक्षित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa dikirim. Kata-katamu tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile inviarlo. Le tue parole restano qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信できませんでした。言葉は残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낼 수 없었어요. 내용은 남아 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon niet worden verstuurd. Je woorden blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wysłać. Twoje słowa są zachowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar. Suas palavras estão guardadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить. Ваши слова сохранены."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haikuweza kutumwa. Maneno yako yamehifadhiwa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilemedi. Sözlerin saklanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося надіслати. Ваші слова збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gửi được. Lời của bạn vẫn được giữ."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A kò lè fi ránṣẹ́. A ṣì ń pa ọ̀rọ̀ rẹ mọ́."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送。你的话已保留。"
          }
        }
      }
    },
