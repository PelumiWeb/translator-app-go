            "state": "translated",
            "value": "कनेक्शन नहीं है। देखें कि आप ऑनलाइन हैं, फिर से भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi. Pastikan kamu online, lalu kirim lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione. Controlla di essere online, poi invialo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がありません。オンラインか確認してから、もう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되어 있지 않아요. 온라인인지 확인한 뒤 다시 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verbinding. Controleer of je online bent en verstuur het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia. Sprawdź, czy masz internet, i wyślij ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão. Verifique se está online e envie de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения. Проверьте интернет и отправьте ещё раз."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna muunganisho. Hakikisha uko mtandaoni, kisha utume tena."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok. Çevrimiçi olduğunu kontrol et, sonra yeniden gönder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає з'єднання. Перевірте інтернет і надішліть ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có kết nối. Hãy kiểm tra bạn đang trực tuyến, rồi gửi lại."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kò sí ìsopọ̀. Rí i dájú pé o wà lórí ayélujára, kí o sì tún fi ránṣẹ́."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有网络连接。请确认已联网，然后重新发送。"
          }
        }
      }
    },
