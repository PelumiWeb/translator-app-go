          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục. Đọc đến hết."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Máa bá a lọ. Kà á dé òpin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续。读到最后。"
          }
        }
      }
