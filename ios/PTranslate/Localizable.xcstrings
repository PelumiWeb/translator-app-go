    "Talk to anyone. You speak your language. They hear theirs, in your voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّث مع أي شخص. أنت تتكلم بلغتك، وهم يسمعونك بلغتهم، بصوتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich mit allen. Du sprichst deine Sprache. Sie hören ihre, mit deiner Stimme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con quien quieras. Tú hablas tu idioma. Te oyen en el suyo, con tu voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez à qui vous voulez. Vous parlez votre langue. On vous entend dans la sienne, avec votre voix."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku yi magana da kowa. Kuna magana da harshenku. Su kuma suna ji da nasu, da muryarku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी से भी बात कीजिए। आप अपनी भाषा बोलते हैं। वे अपनी भाषा में सुनते हैं, आपकी आवाज़ में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicara dengan siapa saja. Kamu bicara dalam bahasamu. Mereka mendengar dalam bahasa mereka, dengan suaramu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla con chiunque. Tu parli la tua lingua. Gli altri ti sentono nella loro, con la tua voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰とでも話せます。あなたは自分の言語で話し、相手は自分の言語で、あなたの声で聞きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구와도 대화하세요. 당신은 당신의 언어로 말하고, 상대는 자신의 언어로, 당신의 목소리로 듣습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praat met iedereen. Jij spreekt je eigen taal. Zij horen de hunne, met jouw stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmawiaj z każdym. Mówisz w swoim języku. Inni słyszą cię w swoim, twoim głosem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale com qualquer pessoa. Você fala seu idioma. Elas ouvem o delas, com a sua voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите с кем угодно. Вы говорите на своём языке. Вас слышат на своём, вашим голосом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongea na mtu yeyote. Unazungumza lugha yako. Wao wanasikia lugha yao, kwa sauti yako."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkesle konuş. Sen kendi dilini konuşursun. Onlar kendi dillerinde, senin sesinle duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Говоріть із ким завгодно. Ви говорите своєю мовою. Вас чують своєю, вашим голосом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện với bất kỳ ai. Bạn nói ngôn ngữ của bạn. Họ nghe bằng ngôn ngữ của họ, với giọng của bạn."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Bá ẹnikẹ́ni sọ̀rọ̀. O ń sọ èdè rẹ. Wọ́n ń gbọ́ tiwọn, ní ohùn rẹ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和任何人交谈。你说你的语言，对方听到他们的语言，而且是你的声音。"
          }
        }
      }
    },
    "Talk to me on %@, in your own language: my ID is @%@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّث معي على %@، بلغتك أنت: معرّفي @%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich mit mir auf %@, in deiner eigenen Sprache: Meine ID ist @%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Talk to me on %1$@, in your own language: my ID is @%2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Háblame en %@, en tu propio idioma: mi ID es @%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle-moi sur %@, dans ta propre langue : mon ID est @%@"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi magana da ni a %@, da harshenka: ID ɗina @%@ ne"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर मुझसे अपनी भाषा में बात करें: मेरी ID @%@ है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngobrol denganku di %@, dalam bahasamu sendiri: ID-ku @%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlami su %@, nella tua lingua: il mio ID è @%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で、あなたの言葉で話しかけてね。私のIDは @%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 네 언어로 나랑 이야기하자. 내 ID는 @%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praat met me op %@, in je eigen taal: mijn ID is @%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porozmawiaj ze mną w %@, w swoim własnym języku: moje ID to @%@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale comigo no %@, no seu próprio idioma: meu ID é @%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поговори со мной в %@ на своём языке: мой ID @%@"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongea nami kwenye %@, kwa lugha yako mwenyewe: kitambulisho changu ni @%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benimle %@ uygulamasında, kendi dilinde konuş: kimliğim @%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поговори зі мною в %@ своєю мовою: мій ID @%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói chuyện với mình trên %@, bằng ngôn ngữ của bạn: ID của mình là @%@"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Bá mi sọ̀rọ̀ lórí %@, ní èdè tìrẹ: ID mi ni @%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来 %@ 和我聊吧，用你自己的语言：我的 ID 是 @%@"
          }
        }
      }
    },
