    "Try again": {},
    "Turn speech into text": {},
    "Two people, one phone, each speaking their own language. It comes with your free week, and with the subscription after it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شخصان، هاتف واحد، وكل منهما يتكلم بلغته. متاح مع أسبوعك المجاني، ثم مع الاشتراك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Menschen, ein Telefon, jeder in seiner eigenen Sprache. Inklusive in deiner Gratiswoche und danach im Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos personas, un teléfono, cada una hablando su idioma. Viene con tu semana gratis y con la suscripción después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux personnes, un téléphone, chacune parlant sa propre langue. Inclus dans votre semaine gratuite, puis dans l'abonnement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutane biyu, waya ɗaya, kowa yana magana da harshensa. Yana zuwa tare da makon kyautarku, da kuma rajista bayansa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो लोग, एक फ़ोन, हर कोई अपनी भाषा में। यह आपके मुफ़्त हफ़्ते के साथ आता है, और उसके बाद सदस्यता के साथ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua orang, satu ponsel, masing-masing berbicara dalam bahasanya sendiri. Termasuk dalam minggu gratismu, lalu dalam langganan sesudahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due persone, un telefono, ognuna nella propria lingua. È inclusa nella settimana gratuita e poi nell'abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2人で1台の電話を使い、それぞれ自分の言語で話せます。無料の1週間と、その後のサブスクリプションで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 사람이 한 휴대폰으로, 각자 자기 언어로 말해요. 무료 1주와 그 이후의 구독에 포함돼요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee mensen, één telefoon, ieder in de eigen taal. Inbegrepen in je gratis week, en daarna in het abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwie osoby, jeden telefon, każda mówi w swoim języku. W ramach darmowego tygodnia, a potem subskrypcji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas pessoas, um telefone, cada uma falando seu próprio idioma. Vem com sua semana grátis e com a assinatura depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два человека, один телефон, и каждый говорит на своём языке. Входит в бесплатную неделю и затем в подписку."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Watu wawili, simu moja, kila mmoja akizungumza lugha yake. Inakuja na wiki yako ya bure, na na usajili baadaye."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki kişi, tek telefon, herkes kendi dilinde. Ücretsiz haftanla, sonra da abonelikle birlikte gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двоє людей, один телефон, і кожен говорить своєю мовою. Входить у безкоштовний тиждень, а потім у підписку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai người, một điện thoại, mỗi người nói ngôn ngữ của mình. Có trong tuần miễn phí của bạn, và trong gói đăng ký sau đó."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ènìyàn méjì, fóònù kan, ẹnì kọ̀ọ̀kan ń sọ èdè tirẹ̀. Ó wà pẹ̀lú ọ̀sẹ̀ ọ̀fẹ́ rẹ, àti pẹ̀lú ìforúkọsílẹ̀ lẹ́yìn rẹ̀."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个人，一部手机，各说各的语言。免费试用周内可用，之后随订阅提供。"
          }
        }
      }
    },
