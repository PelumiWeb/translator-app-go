    "This is how people find you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا يجدك الناس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So finden dich andere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así es como te encuentran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ainsi qu'on vous trouve."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Da shi ne mutane suke samun ku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोग आपको इसी से ढूँढते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan ini orang menemukanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È così che gli altri ti trovano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このIDであなたを見つけてもらえます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람들이 이 ID로 당신을 찾습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo vinden mensen je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po nim inni cię znajdą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É assim que as pessoas encontram você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По нему вас найдут."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hivi ndivyo watu wanavyokupata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlar seni böyle bulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За ним вас знайдуть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người tìm bạn bằng ID này."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Báyìí ni àwọn ènìyàn ṣe ń rí ọ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别人通过它找到你。"
          }
        }
      }
    },
    "This is only to find your account on any phone. We never post anything.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا فقط للعثور على حسابك على أي هاتف. لا ننشر أي شيء أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dient nur dazu, dein Konto auf jedem Telefon zu finden. Wir posten nie etwas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo sirve para encontrar tu cuenta en cualquier teléfono. Nunca publicamos nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela sert uniquement à retrouver votre compte sur n'importe quel téléphone. Nous ne publions jamais rien."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan don a sami asusunku a kowace waya ne kawai. Ba mu taɓa wallafa komai ba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सिर्फ़ किसी भी फ़ोन पर आपका अकाउंट ढूँढने के लिए है। हम कभी कुछ पोस्ट नहीं करते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya untuk menemukan akunmu di ponsel mana pun. Kami tidak pernah memposting apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve solo a trovare il tuo account su qualsiasi telefono. Non pubblichiamo mai nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの電話でもあなたのアカウントを見つけるためだけに使います。勝手に投稿することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 휴대폰에서든 계정을 찾기 위한 용도일 뿐입니다. 저희는 아무것도 게시하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is alleen om je account op elke telefoon terug te vinden. We plaatsen nooit iets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To tylko po to, by znaleźć twoje konto na każdym telefonie. Nigdy niczego nie publikujemy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve apenas para encontrar sua conta em qualquer telefone. Nunca publicamos nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нужно только для того, чтобы найти ваш аккаунт на любом телефоне. Мы никогда ничего не публикуем."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii ni kwa ajili ya kupata akaunti yako kwenye simu yoyote tu. Hatuchapishi chochote kamwe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnızca hesabını her telefonda bulmak içindir. Asla bir şey paylaşmayız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це потрібно лише для того, щоб знайти ваш акаунт на будь-якому телефоні. Ми ніколи нічого не публікуємо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này chỉ để tìm tài khoản của bạn trên bất kỳ điện thoại nào. Chúng tôi không bao giờ đăng gì cả."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Èyí wà fún wíwá àkọọ́lẹ̀ rẹ lórí fóònù èyíkéyìí nìkan. A kì í gbé nǹkan kan jáde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只是为了在任何手机上找到你的账户。我们从不发布任何内容。"
          }
        }
      }
    },
    "This list couldn't be loaded just now.": {
      "localizations": {
        "ar": {
