    "You can read this again in Profile, under What we keep, and why.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك قراءة هذا مرة أخرى في الملف الشخصي، تحت «ما نحتفظ به ولماذا»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das unter Profil, bei Was wir aufbewahren und warum, noch einmal lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver a leer esto en Perfil, en Qué guardamos y por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez relire ceci dans Profil, sous Ce que nous gardons, et pourquoi."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuna iya sake karanta wannan a Bayanin martaba, ƙarƙashin Abin da muke adanawa, da dalili."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इसे फिर से प्रोफ़ाइल में, हम क्या रखते हैं और क्यों के अंतर्गत पढ़ सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa membaca ini lagi di Profil, di bagian Yang kami simpan, dan alasannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi rileggerlo in Profilo, alla voce Cosa conserviamo e perché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは、プロフィールの「保管するものとその理由」でいつでも読み返せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필의 '보관하는 것과 그 이유'에서 다시 읽을 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit opnieuw lezen in Profiel, onder Wat we bewaren, en waarom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz to przeczytać ponownie w Profilu, w sekcji Co przechowujemy i dlaczego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ler isto de novo em Perfil, em O que guardamos e por quê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это можно перечитать в Профиле, в разделе «Что мы храним и зачем»."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unaweza kusoma hili tena kwenye Wasifu, chini ya Tunachohifadhi, na kwa nini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu Profil'de, Neyi saklıyoruz ve neden bölümünde yeniden okuyabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це можна перечитати в Профілі, у розділі «Що ми зберігаємо і навіщо»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đọc lại trong Hồ sơ, mục Chúng tôi giữ gì và vì sao."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "O lè tún èyí kà nínú Profaili, lábẹ́ Ohun tí a ń pa mọ́, àti ìdí rẹ̀."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在“个人资料”的“我们保留什么，以及原因”中再次阅读。"
          }
        }
      }
    },
    "You haven't blocked anyone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تحظر أحدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast niemanden blockiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has bloqueado a nadie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez bloqué personne."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba ku toshe kowa ba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने किसी को ब्लॉक नहीं किया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum memblokir siapa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai bloccato nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックしている人はいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단한 사람이 없어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt niemand geblokkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikogo nie zablokowałeś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não bloqueou ninguém."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы никого не заблокировали."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hujamzuia mtu yeyote."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimseyi engellemedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви нікого не заблокували."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa chặn ai."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "O kò tíì dènà ẹnikẹ́ni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有屏蔽任何人。"
          }
        }
      }
    },
