            "value": "बोली समझ नहीं आई। कृपया फिर से कोशिश करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapan tidak bisa dipahami. Coba lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile capire ciò che hai detto. Riprova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容を聞き取れませんでした。もう一度お試しください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말을 알아들을 수 없었어요. 다시 시도해 주세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De spraak was niet te verstaan. Probeer het opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zrozumieć mowy. Spróbuj ponownie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entender a fala. Tente de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось разобрать речь. Попробуйте ещё раз"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usemi haukueleweka. Tafadhali jaribu tena"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma anlaşılamadı. Lütfen yeniden dene"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося розібрати мовлення. Спробуйте ще раз"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nghe rõ lời nói. Vui lòng thử lại"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A kò lè gbọ́ ọ̀rọ̀ náà yé. Jọ̀wọ́ gbìyànjú lẹ́ẹ̀kan sí i"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法听清说的内容。请再试一次"
          }
        }
      }
    },
