            "state": "translated",
            "value": "Non è stato possibile verificare questo ID ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はこのIDを確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 ID를 확인할 수 없었어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze ID kon nu niet worden gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
