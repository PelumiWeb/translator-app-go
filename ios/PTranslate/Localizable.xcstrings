    "That code isn't a %@ ID. Ask them to open Add someone, then QR code.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز ليس معرّف %@. اطلب منه فتح «إضافة شخص» ثم «رمز QR»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist keine %@-ID. Bitte die Person, Jemanden hinzufügen und dann QR-Code zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no es un ID de %@. Pídele que abra Añadir a alguien y luego Código QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code n'est pas un ID %@. Demandez-lui d'ouvrir Ajouter quelqu'un, puis Code QR."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan lambar ba ID na %@ ba ce. Ku ce su buɗe Ƙara wani, sannan Lambar QR."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड %@ ID नहीं है। उनसे किसी को जोड़ें, फिर QR कोड खोलने को कहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode itu bukan ID %@. Minta dia membuka Tambahkan seseorang, lalu Kode QR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice non è un ID di %@. Chiedigli di aprire Aggiungi qualcuno, poi Codice QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのコードは %@ のIDではありません。相手に「相手を追加」から「QRコード」を開いてもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 코드는 %@ ID가 아니에요. 상대에게 '사람 추가'에서 'QR 코드'를 열어 달라고 하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die code is geen %@-ID. Vraag ze om Voeg iemand toe te openen, en dan QR-code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod nie jest identyfikatorem %@. Poproś, żeby otworzyli Dodaj kogoś, a potem Kod QR."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não é um ID do %@. Peça para a pessoa abrir Adicionar alguém e depois Código QR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код — не ID %@. Попросите открыть «Добавить собеседника», а затем «QR-код»."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Msimbo huo si kitambulisho cha %@. Mwambie afungue Ongeza mtu, kisha Msimbo wa QR."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod bir %@ kimliği değil. Ondan Birini ekle'yi, sonra QR kodu'nu açmasını iste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей код — не ID %@. Попросіть відкрити «Додати співрозмовника», а потім «QR-код»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã đó không phải ID %@. Nhờ họ mở Thêm người, rồi Mã QR."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kóòdù yẹn kì í ṣe ID %@. Sọ fún wọn kí wọ́n ṣí Fi ẹnìkan kún un, lẹ́yìn náà Kóòdù QR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个二维码不是 %@ ID。请对方打开“添加联系人”，再点“二维码”。"
          }
        }
      }
    },
    "That could not be saved just now. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الحفظ الآن. يُرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte gerade nicht gespeichert werden. Bitte versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar ahora mismo. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer pour le moment. Veuillez réessayer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya adanawa yanzu ba. Don Allah a sake gwadawa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सहेजा नहीं जा सका। कृपया फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa disimpan sekarang. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare ora. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は保存できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 저장할 수 없었어요. 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat kon nu niet worden bewaard. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz zapisać. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar agora. Tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось сохранить. Попробуйте ещё раз."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haikuweza kuhifadhiwa sasa hivi. Tafadhali jaribu tena."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda kaydedilemedi. Lütfen yeniden dene."
          }
        },
        "uk": {
