    "Microphone permission is needed to record": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم إذن الميكروفون للتسجيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Aufnahme wird der Zugriff aufs Mikrofon benötigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso para usar el micrófono y grabar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au micro est nécessaire pour enregistrer"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana buƙatar izinin makirufo don naɗi"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करने के लिए माइक्रोफ़ोन की अनुमति चाहिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin mikrofon diperlukan untuk merekam"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve il permesso del microfono per registrare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音するにはマイクへのアクセスが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하려면 마이크 권한이 필요해요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de microfoon is nodig om op te nemen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do nagrywania potrzebny jest dostęp do mikrofonu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso permitir o microfone para gravar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы записывать, нужен доступ к микрофону"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusa ya maikrofoni inahitajika ili kurekodi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt için mikrofon izni gerekiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб записувати, потрібен доступ до мікрофона"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền dùng micrô để ghi âm"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A nílò àṣẹ máikirofóònù láti gbà sílẹ̀"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风权限才能录音"
          }
        }
      }
    },
    "Microphone permission is needed to record your voice": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم إذن الميكروفون لتسجيل صوتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
