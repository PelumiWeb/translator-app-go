    },
    "Your voice couldn't be deleted just now. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حذف صوتك الآن. يُرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme konnte gerade nicht gelöscht werden. Bitte versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido borrar tu voz ahora mismo. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre voix n'a pas pu être supprimée pour le moment. Veuillez réessayer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya goge muryarku yanzu ba. Don Allah a sake gwadawa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आवाज़ अभी हटाई नहीं जा सकी। कृपया फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suaramu tidak bisa dihapus sekarang. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile eliminare la tua voce ora. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は声を削除できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 목소리를 삭제할 수 없었어요. 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je stem kon nu niet worden verwijderd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz usunąć twojego głosu. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível apagar sua voz agora. Tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось удалить ваш голос. Попробуйте ещё раз."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauti yako haikuweza kufutwa sasa hivi. Tafadhali jaribu tena."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesin şu anda silinemedi. Lütfen yeniden dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдалося видалити ваш голос. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể xóa giọng của bạn lúc này. Vui lòng thử lại."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A kò lè pa ohùn rẹ rẹ́ báyìí. Jọ̀wọ́ gbìyànjú lẹ́ẹ̀kan sí i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法删除你的声音。请再试一次。"
          }
        }
      }
    },
