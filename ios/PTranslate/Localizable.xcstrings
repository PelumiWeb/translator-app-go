    "This account has been suspended. If you think that's a mistake, write to us from the help page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعليق هذا الحساب. إذا كنت تظن أن ذلك خطأ، فراسلنا من صفحة المساعدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wurde gesperrt. Wenn du glaubst, dass das ein Fehler ist, schreib uns über die Hilfeseite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta está suspendida. Si crees que es un error, escríbenos desde la página de ayuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte a été suspendu. Si vous pensez que c'est une erreur, écrivez-nous depuis la page d'aide."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An dakatar da wannan asusun. Idan kuna ganin kuskure ne, ku rubuto mana daga shafin taimako."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अकाउंट निलंबित है। अगर आपको लगता है कि यह गलती है, तो मदद पेज से हमें लिखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun ini ditangguhkan. Jika menurutmu ini keliru, tulis kepada kami dari halaman bantuan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account è stato sospeso. Se pensi che sia un errore, scrivici dalla pagina di aiuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは停止されています。誤りだと思われる場合は、ヘルプページからご連絡ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 정지되었습니다. 착오라고 생각되면 도움말 페이지에서 저희에게 연락해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account is geschorst. Denk je dat dat een vergissing is, schrijf ons dan via de helppagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto zostało zawieszone. Jeśli uważasz, że to pomyłka, napisz do nas ze strony pomocy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta foi suspensa. Se achar que é um engano, escreva para nós pela página de ajuda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот аккаунт заблокирован. Если вы считаете, что это ошибка, напишите нам со страницы помощи."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaunti hii imesimamishwa. Ikiwa unadhani ni kosa, tuandikie kupitia ukurasa wa msaada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap askıya alındı. Bunun bir hata olduğunu düşünüyorsan yardım sayfasından bize yaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей акаунт призупинено. Якщо ви вважаєте, що це помилка, напишіть нам зі сторінки допомоги."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản này đã bị tạm ngưng. Nếu bạn nghĩ đây là nhầm lẫn, hãy viết cho chúng tôi từ trang trợ giúp."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A ti dá àkọọ́lẹ̀ yìí dúró. Tí o bá rò pé àṣìṣe ni, kọ̀wé sí wa láti ojú-ìwé ìrànlọ́wọ́."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已被停用。如果你认为这是误会，请通过帮助页面联系我们。"
          }
        }
      }
    },
