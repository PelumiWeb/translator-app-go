    "That was too short. Hold on a little longer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان قصيرًا جدًا. استمر لمدة أطول قليلًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war zu kurz. Halte etwas länger"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha sido demasiado corto. Mantén un poco más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'était trop court. Tenez un peu plus longtemps"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya yi gajere sosai. Riƙe ɗan lokaci kaɗan"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बहुत छोटा था। थोड़ा और देर तक रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu singkat. Tahan sedikit lebih lama"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo breve. Tieni premuto un po' di più"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短すぎました。もう少し長く押してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 짧았어요. 조금 더 길게 누르세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat was te kort. Houd iets langer vast"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To było za krótkie. Przytrzymaj trochę dłużej"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi curto demais. Segure um pouco mais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком коротко. Держите чуть дольше"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiyo ilikuwa fupi mno. Shikilia kwa muda kidogo zaidi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok kısaydı. Biraz daha uzun tut"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надто коротко. Тримайте трохи довше"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá ngắn. Giữ lâu hơn một chút"
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ó kéré jù. Mú un pẹ́ díẹ̀ sí i"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太短了。请再按住久一点"
          }
        }
      }
    },
    "That was very short. Tap the mic, say something, then send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان قصيرًا جدًا. اضغط على الميكروفون، وقل شيئًا، ثم أرسل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war sehr kurz. Tippe aufs Mikrofon, sag etwas und sende es dann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha sido muy corto. Toca el micrófono, di algo y luego envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'était très court. Touchez le micro, dites quelque chose, puis envoyez."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya yi gajere sosai. Taɓa makirufo, faɗi wani abu, sannan aika."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बहुत छोटा था। माइक पर टैप करें, कुछ कहें, फिर भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu sangat singkat. Ketuk mikrofon, katakan sesuatu, lalu kirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Era molto breve. Tocca il microfono, di' qualcosa, poi invia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とても短い録音でした。マイクをタップして何か話してから送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 짧았어요. 마이크를 탭하고 무언가 말한 뒤 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat was heel kort. Tik op de microfoon, zeg iets en verstuur het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To było bardzo krótkie. Dotknij mikrofonu, powiedz coś i wyślij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi muito curto. Toque no microfone, diga algo e depois envie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень коротко. Нажмите на микрофон, скажите что-нибудь и отправьте."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiyo ilikuwa fupi sana. Gusa maikrofoni, sema kitu, kisha utume."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok kısaydı. Mikrofona dokun, bir şey söyle, sonra gönder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуже коротко. Торкніться мікрофона, скажіть щось і надішліть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá ngắn. Chạm vào micrô, nói gì đó, rồi gửi."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ó kéré gan-an. Tẹ máikirofóònù, sọ nǹkan kan, lẹ́yìn náà fi ránṣẹ́."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太短了。轻点麦克风，说点什么，然后发送。"
          }
        }
      }
    },
    "That way of signing in isn't set up on the server yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريقة تسجيل الدخول هذه غير مُعدّة على الخادم بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Art der Anmeldung ist auf dem Server noch nicht eingerichtet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa forma de iniciar sesión aún no está configurada en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mode de connexion n'est pas encore configuré sur le serveur."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a riga an saita wannan hanyar shiga a sabar ba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन का यह तरीका अभी सर्वर पर सेट नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara masuk ini belum diatur di server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo metodo di accesso non è ancora configurato sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサインイン方法は、まだサーバーで設定されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로그인 방식은 아직 서버에 설정되지 않았어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze manier van inloggen is nog niet ingesteld op de server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sposób logowania nie jest jeszcze skonfigurowany na serwerze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa forma de entrar ainda não está configurada no servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот способ входа ещё не настроен на сервере."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Njia hii ya kuingia bado haijawekwa kwenye seva."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu giriş yöntemi sunucuda henüz ayarlanmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей спосіб входу ще не налаштовано на сервері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách đăng nhập này chưa được thiết lập trên máy chủ."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A kò tíì ṣètò ọ̀nà ìwọlé yìí lórí sáfà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器尚未设置这种登录方式。"
          }
        }
      }
    },
    "That's enough. Tap to stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يكفي. اضغط للإيقاف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das reicht. Tippe, um zu stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya es suficiente. Toca para parar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est suffisant. Touchez pour arrêter."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya isa haka. Taɓa don tsayawa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतना काफ़ी है। रोकने के लिए टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah cukup. Ketuk untuk berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta così. Tocca per fermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これで十分です。タップして停止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충분해요. 탭해서 멈추세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo is het genoeg. Tik om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy. Dotknij, aby zatrzymać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já basta. Toque para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно. Нажмите, чтобы остановить."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inatosha. Gusa ili kusimamisha."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kadarı yeter. Durdurmak için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Досить. Торкніться, щоб зупинити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vậy là đủ. Chạm để dừng."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ó ti tó. Tẹ̀ ẹ́ láti dá a dúró."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经足够了。轻点即可停止。"
          }
        }
      }
    },
    "That's your own ID.": {
