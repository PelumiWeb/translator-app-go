            "state": "translated",
            "value": "L'accesso con Apple non è stato completato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleでサインインが完了しませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인이 완료되지 않았어요. 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met Apple is niet afgerond. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Apple nie zostało dokończone. Spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar com a Apple não terminou. Tente de novo."
          }
        },
