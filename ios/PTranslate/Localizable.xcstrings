    "Sign in with Apple didn't finish. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل تسجيل الدخول عبر Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Apple wurde nicht abgeschlossen. Bitte versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con Apple no terminó. Inténtalo de nuevo."
          }
        },
