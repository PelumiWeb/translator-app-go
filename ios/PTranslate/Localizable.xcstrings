    "Only to speak your own words, when someone plays a message you sent. Fish Audio makes the speech for us.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط لنطق كلماتك أنت، عندما يشغّل أحدهم رسالة أرسلتها. Fish Audio تصنع الصوت لنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur um deine eigenen Worte zu sprechen, wenn jemand eine Nachricht abspielt, die du geschickt hast. Fish Audio erzeugt die Sprache für uns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para decir tus propias palabras cuando alguien reproduce un mensaje que enviaste. Fish Audio crea la voz por nosotros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement à dire vos propres mots quand quelqu'un écoute un message que vous avez envoyé. Fish Audio crée la voix pour nous."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Don faɗar kalmominku kawai, idan wani ya kunna saƙon da kuka aika. Fish Audio ne yake samar mana da muryar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ आपके अपने शब्द बोलने के लिए, जब कोई आपका भेजा संदेश चलाता है। Fish Audio हमारे लिए आवाज़ बनाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk mengucapkan kata-katamu sendiri saat seseorang memutar pesan yang kamu kirim. Fish Audio membuat ucapannya untuk kami."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo a pronunciare le tue parole quando qualcuno ascolta un messaggio che hai inviato. Fish Audio crea la voce per noi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが送ったメッセージを誰かが再生するとき、あなた自身の言葉を話すためだけに使います。音声はFish Audioが作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 당신이 보낸 메시지를 재생할 때 당신의 말을 들려주기 위해서만 쓰입니다. 음성은 Fish Audio가 만들어 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen om je eigen woorden uit te spreken als iemand een bericht afspeelt dat jij hebt gestuurd. Fish Audio maakt de spraak voor ons."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko do wypowiadania twoich słów, gdy ktoś odtwarza wysłaną przez ciebie wiadomość. Fish Audio tworzy dla nas mowę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para dizer suas próprias palavras quando alguém ouve uma mensagem que você enviou. A Fish Audio cria a fala para nós."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только чтобы произносить ваши собственные слова, когда кто-то слушает отправленное вами сообщение. Речь для нас создаёт Fish Audio."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni kwa ajili ya kutamka maneno yako mwenyewe tu, mtu anapocheza ujumbe uliotuma. Fish Audio hututengenezea sauti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca biri gönderdiğin bir mesajı oynattığında senin sözlerini söylemek için. Sesi bizim için Fish Audio oluşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише щоб вимовляти ваші власні слова, коли хтось слухає надіслане вами повідомлення. Мовлення для нас створює Fish Audio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ để nói lời của chính bạn khi ai đó phát tin nhắn bạn đã gửi. Fish Audio tạo giọng nói cho chúng tôi."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Láti sọ ọ̀rọ̀ tìrẹ nìkan, nígbà tí ẹnìkan bá ṣí ìfiranṣẹ́ tí o fi ránṣẹ́. Fish Audio ló ń ṣe ohùn náà fún wa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在有人播放你发送的消息时，用来说出你自己的话。语音由 Fish Audio 为我们生成。"
          }
        }
      }
    },
