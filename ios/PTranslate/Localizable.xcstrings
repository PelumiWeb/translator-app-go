    "Payment failed · Apple is retrying": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الدفع · تعيد Apple المحاولة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlung fehlgeschlagen · Apple versucht es erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló el pago · Apple lo está reintentando"
          }
