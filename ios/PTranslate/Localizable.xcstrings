    "Break the language barrier. Be heard in your own voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكسر حاجز اللغة. ليسمعك الناس بصوتك أنت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überwinde die Sprachbarriere. Werde mit deiner eigenen Stimme gehört."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompe la barrera del idioma. Que te escuchen con tu propia voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisez la barrière de la langue. Faites-vous entendre avec votre propre voix."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku karya shingen harshe. A ji ku da muryarku ta kanku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा की दीवार तोड़िए। अपनी ही आवाज़ में सुने जाइए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrak batasan bahasa. Didengar dengan suaramu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbatti la barriera della lingua. Fatti sentire con la tua voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言葉の壁を越えよう。あなた自身の声で届けよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어의 장벽을 넘으세요. 당신의 목소리 그대로 전하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorbreek de taalbarrière. Word gehoord met je eigen stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełam barierę językową. Niech słyszą cię twoim własnym głosem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quebre a barreira do idioma. Seja ouvido com sua própria voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преодолейте языковой барьер. Пусть вас слышат вашим собственным голосом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vunja kizuizi cha lugha. Sikika kwa sauti yako mwenyewe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil engelini aş. Kendi sesinle duyul."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подолайте мовний бар'єр. Нехай вас чують вашим власним голосом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phá bỏ rào cản ngôn ngữ. Được lắng nghe bằng chính giọng của bạn."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Wó ògiri èdè lulẹ̀. Jẹ́ kí wọ́n gbọ́ ọ ní ohùn ara rẹ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打破语言障碍。用你自己的声音被听见。"
          }
        }
      }
    },
