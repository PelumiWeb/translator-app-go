            "value": "أنت تتحدث %@. يسمعونك بـ%@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sprichst %@. Sie hören %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You speak %1$@. They hear %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú hablas %@. Te oyen en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous parlez %@. On vous entend en %@."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuna magana da %@. Suna ji da %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %@ बोलते हैं। वे %@ में सुनते हैं।"
          }
        },
        "id": {
          "stringUnit": {
