    "Let them scan this with their phone's camera, or the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعه يمسحه بكاميرا هاتفه أو بالتطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Person das mit der Kamera ihres Telefons oder mit der App scannen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele que lo escanee con la cámara de su teléfono o con la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-lui de le scanner avec l'appareil photo de son téléphone, ou avec l'app."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku sa su duba wannan da kyamarar wayarsu, ko da manhajar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनसे कहें कि वे इसे अपने फ़ोन के कैमरे या ऐप से स्कैन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta mereka memindai ini dengan kamera ponsel atau aplikasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedigli di scansionarlo con la fotocamera del telefono o con l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の電話のカメラかアプリで読み取ってもらいましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 휴대폰의 카메라나 앱으로 스캔하게 하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat ze dit scannen met de camera van hun telefoon, of met de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś, żeby zeskanowali to aparatem telefonu albo w aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça para escanear com a câmera do telefone ou com o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть отсканируют его камерой телефона или в приложении."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Waambie waichanganue kwa kamera ya simu yao, au kwa programu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonlarının kamerasıyla ya da uygulamayla taratsınlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нехай відскановують його камерою телефона або в застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhờ họ quét mã này bằng camera điện thoại hoặc bằng ứng dụng."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Jẹ́ kí wọ́n fi kámẹ́rà fóònù wọn tàbí ohun èlò náà ka èyí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让对方用手机相机或本应用扫描。"
          }
        }
      }
    },
    "Let's try that again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen wir es noch einmal."
