    "No connection, so this ID could not be checked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال، لذا تعذّر التحقق من هذا المعرّف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung, daher konnte diese ID nicht geprüft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión, así que no se ha podido comprobar este ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion : cet ID n'a pas pu être vérifié."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu haɗi, don haka ba a iya duba wannan ID ɗin ba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन नहीं है, इसलिए इस ID की जाँच नहीं हो सकी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi, jadi ID ini tidak bisa diperiksa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione, quindi non è stato possibile verificare questo ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がないため、このIDを確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되어 있지 않아 이 ID를 확인할 수 없었어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verbinding, dus deze ID kon niet worden gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia, więc nie udało się sprawdzić tego ID."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão, então não foi possível verificar este ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения, поэтому этот ID не удалось проверить."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna muunganisho, kwa hiyo kitambulisho hiki hakikuweza kuangaliwa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok, bu yüzden bu kimlik kontrol edilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає з'єднання, тому цей ID не вдалося перевірити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có kết nối nên không thể kiểm tra ID này."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kò sí ìsopọ̀, nítorí náà a kò lè ṣàyẹ̀wò ID yìí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有网络连接，无法检查此 ID。"
          }
        }
      }
    },
