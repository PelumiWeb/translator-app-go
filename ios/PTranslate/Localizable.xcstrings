    "Add someone by their ID or QR code. You'll hear them in %@, in their own voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف شخصًا بمعرّفه أو برمز QR. ستسمعه بلغتك (%@)، بصوته هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge jemanden per ID oder QR-Code hinzu. Du hörst die Person auf %@, mit ihrer eigenen Stimme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a alguien por su ID o código QR. Lo oirás en %@, con su propia voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez quelqu'un par son ID ou son code QR. Vous l'entendrez en %@, avec sa propre voix."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙara wani ta ID ɗinsa ko lambar QR. Za ku ji shi da %@, da muryarsa ta kansa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी को उनकी ID या QR कोड से जोड़ें। आप उन्हें %@ में, उनकी अपनी आवाज़ में सुनेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan seseorang lewat ID atau kode QR. Kamu akan mendengarnya dalam bahasa %@, dengan suaranya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualcuno con il suo ID o codice QR. Lo sentirai in %@, con la sua voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDかQRコードで相手を追加します。相手の声は%@で、相手自身の声で聞こえます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ID나 QR 코드로 사람을 추가하세요. 상대의 말을 %@로, 상대 본인의 목소리로 듣게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg iemand toe via ID of QR-code. Je hoort ze in het %@, met hun eigen stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj kogoś przez ID lub kod QR. Usłyszysz tę osobę w swoim języku (%@), jej własnym głosem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione alguém pelo ID ou código QR. Você vai ouvir a pessoa em %@, com a própria voz dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте собеседника по ID или QR-коду. Вы будете слышать его на своём языке (%@), его собственным голосом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza mtu kwa kitambulisho au msimbo wa QR. Utamsikia kwa %@, kwa sauti yake mwenyewe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini kimliğiyle ya da QR koduyla ekle. Onu %@ olarak, kendi sesiyle duyacaksın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте співрозмовника за ID або QR-кодом. Ви чутимете його своєю мовою (%@), його власним голосом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm người bằng ID hoặc mã QR. Bạn sẽ nghe họ bằng %@, với chính giọng của họ."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Fi ẹnìkan kún un pẹ̀lú ID tàbí kóòdù QR rẹ̀. Ìwọ yóò gbọ́ ọ ní %@, ní ohùn ara rẹ̀."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 ID 或二维码添加联系人。你会用%@听到对方，而且是对方自己的声音。"
          }
        }
      }
    },
