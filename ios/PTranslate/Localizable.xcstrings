    "On the server. This iPhone's processor is too old for the speech model, so every recording is sent to the server.": {},
    "Only letters, numbers, dots and underscores.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحرف وأرقام ونقاط وشرطات سفلية فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Buchstaben, Zahlen, Punkte und Unterstriche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo letras, números, puntos y guiones bajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement des lettres, chiffres, points et tirets bas."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Haruffa, lambobi, ɗigo da layin ƙasa kawai."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ अक्षर, अंक, बिंदु और अंडरस्कोर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya huruf, angka, titik, dan garis bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lettere, numeri, punti e trattini bassi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字、数字、ピリオド、アンダースコアのみ使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자, 숫자, 마침표, 밑줄만 쓸 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen letters, cijfers, punten en underscores."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko litery, cyfry, kropki i podkreślenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas letras, números, pontos e sublinhados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только буквы, цифры, точки и подчёркивания."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Herufi, namba, nukta na mistari ya chini tu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca harfler, rakamlar, noktalar ve alt çizgiler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише літери, цифри, крапки та підкреслення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ chữ cái, chữ số, dấu chấm và dấu gạch dưới."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Lẹ́tà, nọ́mbà, àmì ìdúró àti ìlà ìsàlẹ̀ nìkan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能使用字母、数字、句点和下划线。"
          }
        }
      }
    },
