    "Fish Audio makes the translation speak in your voice, from the recording you make of it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجعل Fish Audio الترجمة تُنطق بصوتك، انطلاقًا من التسجيل الذي تصنعه له."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio lässt die Übersetzung mit deiner Stimme sprechen, anhand der Aufnahme, die du davon machst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio hace que la traducción suene con tu voz, a partir de la grabación que haces de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio fait parler la traduction avec votre voix, à partir de l'enregistrement que vous en faites."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio yana sa fassarar ta yi magana da muryarku, daga rikodin da kuka yi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio आपकी बनाई रिकॉर्डिंग से अनुवाद को आपकी आवाज़ में बोलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio membuat terjemahan berbicara dengan suaramu, dari rekaman yang kamu buat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio fa parlare la traduzione con la tua voce, a partire dalla registrazione che ne fai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audioは、あなたが録音した声をもとに、翻訳をあなたの声で話させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio는 당신이 녹음한 목소리를 바탕으로 번역문을 당신의 목소리로 들려줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio laat de vertaling spreken met jouw stem, op basis van de opname die je ervan maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio sprawia, że tłumaczenie mówi twoim głosem, na podstawie nagrania, które robisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fish Audio faz a tradução falar com a sua voz, a partir da gravação que você faz dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio озвучивает перевод вашим голосом — по записи, которую вы для этого делаете."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio huifanya tafsiri izungumze kwa sauti yako, kutokana na rekodi unayoifanya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio, yaptığın kayıttan yola çıkarak çeviriyi senin sesinle konuşturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio озвучує переклад вашим голосом — за записом, який ви для цього робите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio cho bản dịch cất lên bằng giọng của bạn, dựa trên bản ghi âm bạn thực hiện."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio ń jẹ́ kí ìtumọ̀ náà dún ní ohùn rẹ, láti inú ohùn tí o gbà sílẹ̀."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish Audio 根据你录下的声音，让译文用你的声音说出来。"
          }
        }
      }
    },
