          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kò tíì sí ẹni tí ó ní ID @%@. Ṣàyẹ̀wò ìkọ̀wé rẹ̀ pẹ̀lú wọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
