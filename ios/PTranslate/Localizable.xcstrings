          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso para usar el micrófono y grabar tu voz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au micro est nécessaire pour enregistrer votre voix"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana buƙatar izinin makirufo don naɗar muryarku"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आवाज़ रिकॉर्ड करने के लिए माइक्रोफ़ोन की अनुमति चाहिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin mikrofon diperlukan untuk merekam suaramu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve il permesso del microfono per registrare la tua voce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声を録音するにはマイクへのアクセスが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리를 녹음하려면 마이크 권한이 필요해요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de microfoon is nodig om je stem op te nemen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do nagrania głosu potrzebny jest dostęp do mikrofonu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso permitir o microfone para gravar sua voz"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы записать голос, нужен доступ к микрофону"
