    "Shown to the people you talk to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر لمن تتحدث معهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird den Menschen angezeigt, mit denen du sprichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo verán las personas con quienes hables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible par les personnes avec qui vous parlez."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutanen da kuke magana da su ne za su gani."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिनसे आप बात करते हैं, उन्हें दिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditampilkan kepada orang yang kamu ajak bicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo vedono le persone con cui parli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話す相手に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화하는 사람들에게 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zichtbaar voor de mensen met wie je praat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widoczne dla osób, z którymi rozmawiasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece para as pessoas com quem você fala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это увидят те, с кем вы разговариваете."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huonyeshwa kwa watu unaozungumza nao."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuştuğun kişilere gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це бачитимуть ті, з ким ви розмовляєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị cho những người bạn trò chuyện cùng."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Àwọn tí o bá ń bá sọ̀rọ̀ ni yóò rí i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会显示给和你交谈的人。"
          }
        }
      }
    },
