    "Start your free week, or subscribe, to send. Your note is kept here to send then.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ أسبوعك المجاني أو اشترك لترسل. رسالتك محفوظة هنا لتُرسَل حينها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte deine Gratiswoche oder schließe ein Abo ab, um zu senden. Deine Nachricht wird hier aufbewahrt und dann gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza tu semana gratis o suscríbete para enviar. Tu nota se queda aquí para enviarla entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez votre semaine gratuite, ou abonnez-vous, pour envoyer. Votre note est gardée ici pour être envoyée ensuite."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fara makon kyautarku, ko ku yi rajista, don aikawa. An adana saƙonku a nan don a aika shi a lokacin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने के लिए अपना मुफ़्त हफ़्ता शुरू करें, या सदस्यता लें। आपका नोट तब भेजने के लिए यहीं रखा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai minggu gratismu, atau berlangganan, untuk mengirim. Pesanmu disimpan di sini untuk dikirim nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia la settimana gratuita, o abbonati, per inviare. La tua nota resta qui per essere inviata allora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信するには無料の1週間を始めるか、登録してください。メッセージはここに残り、そのときに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내려면 무료 1주를 시작하거나 구독하세요. 메시지는 그때 보낼 수 있도록 여기 남아 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin je gratis week, of neem een abonnement, om te versturen. Je bericht blijft hier om dan te versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij darmowy tydzień lub wykup subskrypcję, aby wysyłać. Twoja wiadomość czeka tu, żeby ją wtedy wysłać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece sua semana grátis ou assine para enviar. Sua nota fica guardada aqui para ser enviada depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните бесплатную неделю или оформите подписку, чтобы отправлять. Ваше сообщение сохранится здесь, чтобы отправить его тогда."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Anza wiki yako ya bure, au jisajili, ili utume. Ujumbe wako umehifadhiwa hapa ili utumwe wakati huo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndermek için ücretsiz haftanı başlat ya da abone ol. Notun o zaman gönderilmek üzere burada saklanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть безкоштовний тиждень або оформіть підписку, щоб надсилати. Ваше повідомлення збережеться тут, щоб надіслати його тоді."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu tuần miễn phí, hoặc đăng ký, để gửi. Tin nhắn của bạn được giữ ở đây để gửi khi đó."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Bẹ̀rẹ̀ ọ̀sẹ̀ ọ̀fẹ́ rẹ, tàbí forúkọ sílẹ̀, láti fi ránṣẹ́. A ń pa ìfiranṣẹ́ rẹ mọ́ síbí láti fi ránṣẹ́ nígbà náà."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始免费试用周或订阅后即可发送。你的语音会保留在这里，届时再发送。"
          }
        }
      }
    },
