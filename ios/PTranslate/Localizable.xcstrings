            "value": "Trabajando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana aiki"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम हो रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memproses"
