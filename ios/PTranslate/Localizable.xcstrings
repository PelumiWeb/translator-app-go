    "By continuing you agree to the Terms and Privacy Policy.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالمتابعة، أنت توافق على الشروط وسياسة الخصوصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fortfährst, stimmst du den Nutzungsbedingungen und der Datenschutzerklärung zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas los Términos y la Política de privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez les Conditions et la Politique de confidentialité."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Idan kuka ci gaba, kun yarda da Sharuɗɗa da Manufar Sirri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखकर आप शर्तों और निजता नीति से सहमत होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan melanjutkan, kamu menyetujui Ketentuan dan Kebijakan Privasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando accetti i Termini e l'Informativa sulla privacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けると、利用規約とプライバシーポリシーに同意したことになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하면 이용약관과 개인정보 처리방침에 동의하게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door verder te gaan, ga je akkoord met de Voorwaarden en het Privacybeleid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuując, akceptujesz Warunki i Politykę prywatności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao continuar, você aceita os Termos e a Política de Privacidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжая, вы принимаете Условия и Политику конфиденциальности."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukiendelea, unakubali Masharti na Sera ya Faragha."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam ederek Koşulları ve Gizlilik Politikasını kabul etmiş olursun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуючи, ви приймаєте Умови та Політику конфіденційності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tiếp tục, bạn đồng ý với Điều khoản và Chính sách quyền riêng tư."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Tí o bá tẹ̀síwájú, o gbà sí Àwọn Òfin àti Ìlànà Àṣírí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续即表示你同意《条款》和《隐私政策》。"
          }
        }
      }
    },
