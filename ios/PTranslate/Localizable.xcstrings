    "Say something to %@, or write it. They'll get it in %@, in your voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل شيئًا لـ%@، أو اكتبه. سيصله بـ%@، بصوتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag etwas zu %@ oder schreib es. Die Person bekommt es auf %@, mit deiner Stimme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Say something to %1$@, or write it. They'll get it in %2$@, in your voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile algo a %@ o escríbelo. Lo recibirá en %@, con tu voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites quelque chose à %@, ou écrivez-le. La personne le recevra en %@, avec votre voix."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku faɗa wa %@ wani abu, ko ku rubuta. Zai karɓa da %@, da muryarku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से कुछ कहें, या लिखें। उन्हें यह %@ में, आपकी आवाज़ में मिलेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Katakan sesuatu kepada %@, atau tuliskan. Dia akan menerimanya dalam bahasa %@, dengan suaramu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' qualcosa a %@, o scrivilo. Lo riceverà in %@, con la tua voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に何か話しかけるか、書いてください。相手には%@で、あなたの声で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님에게 말하거나 글로 쓰세요. 상대는 %@로, 내 목소리로 받아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg iets tegen %@, of schrijf het. Ze krijgen het in het %@, met jouw stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz coś (do: %@) albo to napisz. Dostanie to w języku: %@, twoim głosem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga algo para %@ ou escreva. A pessoa vai receber em %@, com a sua voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите что-нибудь (собеседник: %@) или напишите. Он получит это на языке «%@» вашим голосом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwambie %@ kitu, au kiandike. Atakipata kwa %@, kwa sauti yako."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisine bir şey söyle ya da yaz. Senin sesinle, %@ olarak alacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть щось (співрозмовник: %@) або напишіть. Він отримає це мовою «%@» вашим голосом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nói gì đó với %@, hoặc viết ra. Họ sẽ nhận bằng %@, với giọng của bạn."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sọ nǹkan kan fún %@, tàbí kọ ọ́. Wọn yóò gbà á ní %@, ní ohùn rẹ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对 %@ 说点什么，或者写下来。对方会用%@收到，而且是你的声音。"
          }
        }
      }
    },
