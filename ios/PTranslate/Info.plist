<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BackendURL</key>
	<string>$(BACKEND_URL)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_NAME)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>$(APP_NAME) records what you say so it can write it down and translate it.</string>
	<key>NSCameraUsageDescription</key>
	<string>$(APP_NAME) scans the QR code of someone you want to add.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pelumi.shinar.add</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>shinar</string>
			</array>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>$(APP_NAME) talks to the development server on this network.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIAppFonts</key>
	<array>
		<string>IBMPlexSans-Regular.ttf</string>
		<string>IBMPlexSans-Medium.ttf</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
